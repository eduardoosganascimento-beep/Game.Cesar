{
  "name": "sandman",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Sandman — jogo indie 2D em pixel art, TypeScript + Canvas 2D.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "levels:check": "node scripts/validate-levels.mjs",
    "preview": "vite preview",
    "sprites": "node scripts/crop-sheet.mjs"
  },
  "devDependencies": {
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
